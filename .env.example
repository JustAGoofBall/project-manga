# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is in .gitignore and must never be committed.

# Port the API listens on.
PORT=3000

# 'development', 'production' or 'test'.
# Rate limiting is only enforced in production.
NODE_ENV=development

# Secret used to sign login tokens.
# REQUIRED in production - without it the API falls back to a default that
# is publicly visible in config/jwt.js, meaning anyone could forge a login.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# The API currently stores its data in a SQLite file (see config/db.js), so
# the settings below are NOT used yet. They are kept for the planned move to
# MySQL, which is what schema.sql and the db service in docker-compose.yaml
# are for.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=anime_db
DB_TEST_NAME=anime_db_test
DB_PORT=3306
